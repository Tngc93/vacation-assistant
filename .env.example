# Copy to .env.local and fill in. Never commit real values.
# Travelpayouts (Aviasales Data API): token from your Travelpayouts profile → API token.
# Read only on the server; without it the flights section shows links to live prices instead of cards.
TRAVELPAYOUTS_TOKEN=
# Your Travelpayouts partner ID (numeric "marker"), added to Aviasales links.
TRAVELPAYOUTS_MARKER=
